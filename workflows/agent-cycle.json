        "headerParameters": {
          "parameters": [
            {
              "name": "x-run-secret",
              "value": "={{ $env.RUN_CYCLE_SECRET || 'your-run-cycle-secret' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "e4f5a6b7-c8d9-4e0f-1a2b-3c4d5e6f7a8b",
      "name": "HTTP Request - Trigger Autonomous Run Cycle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Schedule Trigger (Every 4 Hours)": {
      "main": [
        [
          {
            "node": "HTTP Request - Trigger Autonomous Run Cycle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
